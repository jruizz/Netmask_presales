# Copia este archivo a ".env" y reemplaza los valores antes de levantar el stack.
# ".env" NUNCA debe subirse a un repositorio (ver .gitignore).

# Puerto publicado en el host (unico puerto expuesto, via el servicio proxy)
PUBLISHED_PORT=8080

# Base de datos
POSTGRES_USER=netmask
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=netmask_presales

# Autenticacion
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# CORS: dominio desde el que se sirve el frontend (via el proxy)
CORS_ORIGIN=http://localhost:8080

# Usuario superadmin creado automaticamente la primera vez que el backend
# arranca y no existe ningun usuario en la base de datos.
SUPERADMIN_EMAIL=admin@netmask.co
SUPERADMIN_PASSWORD=cambia-esta-contrasena-al-primer-login
SUPERADMIN_NOMBRE=Administrador Netmask
